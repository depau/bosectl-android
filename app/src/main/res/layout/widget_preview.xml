<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview only — never inflated by the widget itself.

  It mirrors the 2-row Glance layout (header + mode buttons + head tracking) at
  the declared 4x2 target size, with the factory presets and their real icons.
  Text and colors are duplicated from BoseWidget.kt because the launcher inflates
  this in its own process, where GlanceTheme and the cached state don't exist; if
  the widget's look changes, this has to be updated by hand.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_surface"
    android:backgroundTint="@color/widget_preview_surface"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <!-- Header: attribution icon, name, link status, battery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="QC Ultra Earbuds"
            android:textColor="@color/widget_preview_on_surface"
            android:textFontWeight="500"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_media_bluetooth_on"
            android:tint="@color/widget_preview_selected"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_earbud_left"
            android:tint="@color/widget_preview_on_surface"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="80%"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_earbud_right"
            android:tint="@color/widget_preview_on_surface"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="75%"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_earbud_case"
            android:tint="@color/widget_preview_on_surface"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="70%"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Mode buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_chip"
            android:backgroundTint="@color/widget_preview_selected">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ic_noise_control_on"
                android:tint="@color/widget_preview_on_selected"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quiet"
                android:textColor="@color/widget_preview_on_selected"
                android:textFontWeight="500"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_chip"
            android:backgroundTint="@color/widget_preview_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ic_noise_aware"
                android:tint="@color/widget_preview_on_surface"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aware"
                android:textColor="@color/widget_preview_on_container"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_chip"
            android:backgroundTint="@color/widget_preview_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ic_spatial_tracking"
                android:tint="@color/widget_preview_on_surface"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Immersion"
                android:textColor="@color/widget_preview_on_container"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Head tracking -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_preview_chip"
            android:backgroundTint="@color/widget_preview_selected">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_spatial_audio_off"
                android:tint="@color/widget_preview_on_selected"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Off"
                android:textColor="@color/widget_preview_on_selected"
                android:textFontWeight="500"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_preview_chip"
            android:backgroundTint="@color/widget_preview_container">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_spatial_tracking"
                android:tint="@color/widget_preview_on_surface"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Still"
                android:textColor="@color/widget_preview_on_container"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_preview_chip"
            android:backgroundTint="@color/widget_preview_container">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_spatial_audio"
                android:tint="@color/widget_preview_on_surface"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motion"
                android:textColor="@color/widget_preview_on_container"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
