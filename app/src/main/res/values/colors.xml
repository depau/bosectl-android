<resources>
    <color name="ic_launcher_background">#1A1C1E</color>

    <!-- Widget picker preview only. The live widget uses GlanceTheme, but the
         preview layout is inflated by the launcher, where those colors don't
         exist — so map onto the platform dynamic palette (API 31+) by hand.
         values-night mirrors this with the dark tones. -->
    <color name="widget_preview_surface">@android:color/system_neutral1_50</color>
    <color name="widget_preview_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_preview_container">@android:color/system_accent2_100</color>
    <color name="widget_preview_on_container">@android:color/system_accent2_900</color>
    <color name="widget_preview_selected">@android:color/system_accent1_600</color>
    <color name="widget_preview_on_selected">@android:color/system_accent1_0</color>
</resources>
